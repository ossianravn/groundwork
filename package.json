{
  "name": "groundwork",
  "private": true,
  "version": "0.1.0",
  "description": "A reusable shadcn/ui kit and reference demo for public websites and admin interfaces, with centralized, customizable design tokens.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ossianravn/groundwork.git"
  },
  "type": "module",
  "packageManager": "npm@11.17.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "npm run lint:eslint && npm run lint:anti-slop",
    "lint:eslint": "eslint .",
    "lint:anti-slop": "node tools/lint-anti-slop.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write src eslint.config.js vite.config.ts tsconfig*.json index.html package.json",
    "format:check": "prettier --check src eslint.config.js vite.config.ts tsconfig*.json index.html package.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tanstack/react-router": "^1.170.39",
    "@tanstack/react-table": "^9.2.4",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@tiptap/static-renderer": "^3.31.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "culori": "^4.0.2",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.3",
    "recharts": "^3.8.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@oxlint/plugins": "1.85.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "oxlint": "1.85.0",
    "prettier": "^3.9.9",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
